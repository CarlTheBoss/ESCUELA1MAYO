generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Persona {
  id                    String   @id @default(uuid())
  tipo                  String   // 'MUJER' | 'HOMBRE'
  nombre                String
  apellido              String
  fechaUltimaAsignacion DateTime
  sala                  String
  rol                   String
  frecuencia            String
  observacion           String
  ultimoDiscurso5Min    DateTime?
  salaUltimoDiscurso    String?  // 'A' | 'B' - Sala del último discurso de 5 min
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
